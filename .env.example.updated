# ============================================
# AMS v2.0.0 - Environment Configuration
# ============================================

APP_NAME="Attendance Management System"
APP_ENV=production
APP_KEY=base64:your-app-key-here
APP_DEBUG=false
APP_URL=https://your-app.railway.app

# ============================================
# LOCALIZATION (NEW in v2.0.0)
# ============================================
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ams_database
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# CACHE & SESSION
# ============================================
# For better performance, use redis in production
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Production recommended:
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis

# ============================================
# REDIS (Optional - for better performance)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# QUEUE
# ============================================
QUEUE_CONNECTION=sync

# Production recommended:
# QUEUE_CONNECTION=redis

# ============================================
# MAIL
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@ams.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=error

# Development:
# LOG_LEVEL=debug

# ============================================
# PERFORMANCE (NEW in v2.0.0)
# ============================================
# Schedule cache TTL (in seconds)
SCHEDULE_CACHE_TTL=3600

# Enable query logging (for debugging only)
DB_LOG_QUERIES=false

# ============================================
# FINGERSPOT DEVICE
# ============================================
FINGERSPOT_DEFAULT_PORT=4370
FINGERSPOT_TIMEOUT=10

# ============================================
# HOLIDAY API
# ============================================
HOLIDAY_API_PRIMARY=https://libur.deno.dev/api
HOLIDAY_API_FALLBACK=https://api-hari-libur.vercel.app/api
HOLIDAY_CACHE_TTL=2592000

# ============================================
# UI/UX (NEW in v2.0.0)
# ============================================
# Default theme (light or dark)
DEFAULT_THEME=light

# Enable auto dark mode detection
AUTO_DARK_MODE=true

# ============================================
# SECURITY
# ============================================
# Change these in production!
ADMIN_DEFAULT_EMAIL=admin@ams.com
ADMIN_DEFAULT_PASSWORD=admin@ams.com

# Session security
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================
# RAILWAY SPECIFIC (if deploying to Railway)
# ============================================
# These are auto-populated by Railway
# DATABASE_URL=
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=

# ============================================
# OPTIONAL SERVICES
# ============================================
# AWS S3 (for file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (for real-time notifications)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Telescope (Laravel debugging tool)
# TELESCOPE_ENABLED=false

# Debugbar (Laravel debug bar)
# DEBUGBAR_ENABLED=false

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env and update values
# 2. Run: php artisan key:generate
# 3. Run: php artisan migrate
# 4. Run: php artisan config:cache (production only)
# 5. Change default admin credentials immediately!
